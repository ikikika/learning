# Dev-server ports by role (npm start / webpack serve)
PORT_STANDALONE=3000
PORT_SHELL=3001
PORT_REMOTE=3002

# Optional override for the current process (takes precedence over role port)
# PORT=3000

# Host used when building local URLs (compose, remoteEntry)
DEV_HOST=127.0.0.1

# Shell Module Federation remote entry (defaults to http://$DEV_HOST:$PORT_REMOTE/remoteEntry.js)
# DEMO_REMOTE_URL=http://127.0.0.1:3002/remoteEntry.js
