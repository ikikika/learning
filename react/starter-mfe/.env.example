# Dev-server ports by role (filled by `npm run init -- --role=… --port=…`)
PORT_STANDALONE=
PORT_SHELL=
PORT_REMOTE=

# Optional override for the current process (takes precedence over role port)
# PORT=

# Host used when building local URLs (compose, remoteEntry)
DEV_HOST=127.0.0.1

# Shell Module Federation remote entries (one env key per remotes[].urlEnv)
# Written by `npm run init -- --remote=…` or `npm run add-remote -- --alias=… --port=…`
# DEMO_REMOTE_URL=http://127.0.0.1:<remote-port>/remoteEntry.js
# BILLING_REMOTE_URL=http://127.0.0.1:<port>/remoteEntry.js
# Any remotes[].urlEnv key follows the same pattern (ALIAS_URL).

API_BASE_URL=https://jsonplaceholder.typicode.com/
