{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starter-mfe.local/schemas/starter.role.json",
  "title": "StarterRoleMetadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["role", "version"],
  "properties": {
    "role": {
      "type": "string",
      "enum": ["standalone", "shell", "remote"],
      "description": "Exactly one repository role after init"
    },
    "version": {
      "type": "integer",
      "const": 1,
      "description": "Metadata schema version"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Optional ISO-8601 timestamp of last successful init"
    }
  }
}
