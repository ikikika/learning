{
  "name": "starter-mfe",
  "version": "0.1.0",
  "private": true,
  "description": "In-repo React starter with standalone | shell | remote roles (Webpack Module Federation)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "init": "node scripts/init.mjs",
    "start": "webpack serve --mode development",
    "build": "webpack --mode production",
    "test": "jest && node --test tests/contract/*.test.mjs",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:compose": "node scripts/compose-harness.mjs",
    "test:a11y": "node scripts/run-a11y.mjs"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.49.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "css-loader": "^7.1.2",
    "html-webpack-plugin": "^5.6.3",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "sass": "^1.83.0",
    "sass-loader": "^16.0.4",
    "style-loader": "^4.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "typescript": "^5.7.2",
    "webpack": "^5.97.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.0",
    "workbox-webpack-plugin": "^7.4.1"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "minimatch": "10.2.6",
    "uuid": "11.1.1",
    "ejs": "6.0.1",
    "serialize-javascript": "7.0.7"
  }
}
