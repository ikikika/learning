# Resolve react_native_pods.rb dynamically (RN 0.81+ compatible)
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve("react-native/scripts/react_native_pods.rb", { paths: [process.argv[1]] })',
  __dir__
]).strip

platform :ios, '16.0'

prepare_react_native_project!

# Enable static linking (required for Firebase)
use_frameworks! :linkage => :static
$RNFirebaseAsStaticFramework = true

target 'donationapp' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => true,  # Optional: enable Hermes
    :fabric_enabled => true,  # Optional: enable Fabric/new arch
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  # --- Firebase (optional but common) ---
  pod 'Firebase/Core'
  pod 'Firebase/Auth'
  pod 'Firebase/Firestore'

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )

    # Fixes some Xcode 15+ build warnings
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['BUILD_LIBRARY_FOR_DISTRIBUTION'] = 'YES'
      end
    end
  end
end
